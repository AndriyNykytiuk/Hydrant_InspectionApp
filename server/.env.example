# --- База даних ---
# DATABASE_URL  — використовує застосунок (PrismaClient) у рантаймі
# DIRECT_URL    — використовують міграції (prisma migrate deploy)
#
# Локальна розробка (docker-compose) — обидва однакові, localhost:
#   DATABASE_URL=postgresql://hydrants:hydrants@localhost:5432/hydrants?schema=public
#   DIRECT_URL=postgresql://hydrants:hydrants@localhost:5432/hydrants?schema=public
#
# Supabase (прод): DATABASE_URL = транзакційний пулер (порт 6543, ?pgbouncer=true),
#                  DIRECT_URL   = пряме/session-підключення (порт 5432).
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#   DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://hydrants:hydrants@localhost:5432/hydrants?schema=public
DIRECT_URL=postgresql://hydrants:hydrants@localhost:5432/hydrants?schema=public

PORT=5000
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# APP_URL — базовий URL фронтенду (використовується для посилання в QR-коді)
APP_URL=http://localhost:5173
# Список дозволених origin'ів через кому. Порожнє/відсутнє = дозволити всім (тільки для dev)
CORS_ORIGIN=

UPLOAD_DIR=./uploads

SEED_GOD_EMAIL=god@example.com
SEED_GOD_PASSWORD=changeme123
SEED_GOD_NAME=Адміністратор
SEED_BRIGADE_NAME=Частина №1
