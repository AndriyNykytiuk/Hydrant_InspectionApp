generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  god
  rw
  viewer
}

enum NetworkType {
  ring
  deadend
}

model Brigade {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  users    User[]
  hydrants Hydrant[]
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  fullName     String
  role         UserRole
  brigadeId    Int?
  brigade      Brigade?  @relation(fields: [brigadeId], references: [id])
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  inspections Inspection[]

  @@index([brigadeId])
}

model Hydrant {
  id          Int         @id @default(autoincrement())
  brigadeId   Int
  brigade     Brigade     @relation(fields: [brigadeId], references: [id])
  number      String
  address     String
  networkType NetworkType
  diameter    Int
  createdAt   DateTime    @default(now())
  deletedAt   DateTime?

  inspections Inspection[]

  @@index([brigadeId])
  @@index([number])
}

model Inspection {
  id          Int      @id @default(autoincrement())
  hydrantId   Int
  hydrant     Hydrant  @relation(fields: [hydrantId], references: [id])
  inspectorId Int
  inspector   User     @relation(fields: [inspectorId], references: [id])

  // Загальний стан гідранта (Q1 — "перебуває у справному стані?").
  isWorking Boolean

  // Відповіді на пункти перевірки: map { questionKey: boolean | null }.
  // Перелік питань визначається в client checklist.js — єдине джерело правди,
  // тож зміна списку питань не потребує міграції БД.
  checks Json @default("{}")

  weakness    String   @default("")
  createdAt   DateTime @default(now())

  photos Photo[]

  @@index([hydrantId, createdAt])
}

model Photo {
  id           Int        @id @default(autoincrement())
  inspectionId Int
  inspection   Inspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  url          String
  createdAt    DateTime   @default(now())
}
